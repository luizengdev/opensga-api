# =============================================================================
# OpenSGA API — variáveis de ambiente
# Copie este arquivo para .env e preencha os valores locais:
#   cp .env-example .env
# Nunca commite o arquivo .env.
# =============================================================================

# --- Runtime -----------------------------------------------------------------
NODE_ENV=development
PORT=3333
API_BASE_URL=http://localhost:3333
FRONTEND_URL=http://localhost:3000

# --- PostgreSQL --------------------------------------------------------------
# Deve coincidir com docker-compose.yml (postgres / password / opensga-api).
DATABASE_URL=postgresql://postgres:password@localhost:5432/opensga-api

# --- JWT ---------------------------------------------------------------------
# Use um segredo longo e aleatório em qualquer ambiente compartilhado.
# JWT_EXPIRES_IN é o fallback do plugin. Login e POST /auth/renovar usam 20m
# (ADMIN/PROFESSOR) ou 30m (ALUNO/RESPONSAVEL), independentemente deste valor.
JWT_SECRET=altere-este-segredo-jwt
JWT_EXPIRES_IN=20m

# --- Stripe (opcional em desenvolvimento sem cobrança) -----------------------
# Sem STRIPE_SECRET_KEY o servidor sobe, mas precificação, checkout e seed
# de catálogo Stripe são ignorados ou falham. Webhook exige o secret do CLI.
STRIPE_SECRET_KEY=sk_test_xxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxx
STRIPE_INSCRICAO_COUPON_ID=isencao-inscricao

# --- Cloudinary (opcional) ---------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- SMTP / Nodemailer (opcional) --------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
